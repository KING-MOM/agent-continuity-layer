{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-continuity-layer/schemas/v1/project-registry.json",
  "title": "Project Registry (aggregate view)",
  "description": "Aggregate/derived view of all projects known to the continuity layer. M3 LEGACY: one canonical file on the VM, mirrored read-only to every device, single-writer through OpenClaw. M10.1 RECLASSIFIES this as a derivable view — per-project entries at core/schemas/project-registry-entry.schema.json are the canonical store; the aggregate is rebuilt on-demand from those entries. Any M3 reader expecting the single-file form still gets it; multi-device writers use the per-project schema.",
  "type": "object",
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "updated_at": { "type": "string", "format": "date-time" },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/Project" }
    }
  },
  "$defs": {
    "Project": {
      "type": "object",
      "required": ["uuid", "name", "created_at"],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^proj-[a-z0-9-]+$",
          "description": "Stable identifier. Format: proj-{kebab-name}-{epoch-tail}."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_active": { "type": "string", "format": "date-time" },
        "last_device": { "type": "string" },
        "last_interface": {
          "type": "string",
          "enum": ["claude-code", "codex-cli", "openclaw", "whatsapp", "telegram", "web", "other"]
        },
        "context_summary": { "type": "string" },
        "files_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "repos": {
          "type": "array",
          "description": "Git repos associated with this project. Trust policy is keyed off these.",
          "items": {
            "type": "object",
            "required": ["origin"],
            "properties": {
              "origin": { "type": "string", "format": "uri" },
              "local_paths": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Per-device clone paths. Never sync these as canonical."
              }
            }
          }
        },
        "owners": {
          "type": "array",
          "description": "Authorized humans for this project.",
          "items": { "type": "string", "format": "email" }
        }
      }
    }
  }
}
